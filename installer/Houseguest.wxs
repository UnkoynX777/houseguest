<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="Houseguest" Manufacturer="Houseguest contributors" Version="$(Version)"
           UpgradeCode="6b0f4f52-9a3e-4c5b-8a3e-2f6a2a1e7c11" Scope="perMachine" InstallerVersion="500"
           Language="1033" Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Houseguest is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="AppIcon" SourceFile="$(RepoRoot)\host\houseguest.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/UnkoynX777/houseguest" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Houseguest">
        <Directory Id="UiFolder" Name="ui" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <ComponentGroup Id="ServiceFiles" Directory="INSTALLFOLDER">
      <Component Id="ServiceExe" Guid="*">
        <File Id="ServiceExeFile" Source="$(BuildDir)\service\houseguest-service.exe" KeyPath="yes" />
        <ServiceInstall Id="HouseguestService" Name="Houseguest" DisplayName="Houseguest Access Control"
                        Description="Enforces Houseguest guest-session application policies. Stopping it requires administrator rights."
                        Type="ownProcess" Start="auto" ErrorControl="normal" Vital="yes" />
        <ServiceControl Id="ControlHouseguest" Name="Houseguest" Start="install" Stop="both" Remove="uninstall" Wait="yes" />
        <util:ServiceConfig ServiceName="Houseguest" FirstFailureActionType="restart" SecondFailureActionType="restart"
                            ThirdFailureActionType="restart" RestartServiceDelayInSeconds="5" ResetPeriodInDays="1" />
      </Component>
      <Component Id="CliExe" Guid="*">
        <File Id="CliExeFile" Source="$(BuildDir)\service\houseguest-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="ApplicationFiles" Directory="INSTALLFOLDER">
      <Component Id="HostExe" Guid="*">
        <File Id="HostExeFile" Source="$(BuildDir)\host\houseguest.exe" KeyPath="yes" />
        <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Houseguest" WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon" Advertise="no" />
      </Component>
      <Component Id="LicenseFile" Guid="*">
        <File Id="LicenseTxt" Source="$(RepoRoot)\LICENSE" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="UiFiles" Directory="UiFolder">
      <Files Include="$(UiDist)\**" />
    </ComponentGroup>

    <Feature Id="Main" Title="Houseguest" Level="1">
      <ComponentGroupRef Id="ServiceFiles" />
      <ComponentGroupRef Id="ApplicationFiles" />
      <ComponentGroupRef Id="UiFiles" />
    </Feature>
  </Package>
</Wix>
