# Turns the files of the remote panel into a C++ source so the service serves them from memory.
function(houseguest_embed_panel output)
  set(body "// Generated from service/panel. Do not edit.\n#include \"api/assets.hpp\"\n\nnamespace houseguest::service::api {\nnamespace {\n")
  set(table "")
  set(index 0)
  foreach(entry IN LISTS ARGN)
    string(REPLACE "|" ";" parts "${entry}")
    list(GET parts 0 file)
    list(GET parts 1 route)
    list(GET parts 2 type)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${file}")
    file(READ "${file}" hex HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(APPEND body "const unsigned char kAsset${index}[] = {${bytes}0x00};\n")
    set(INDEX ${index})
    set(ROUTE "${route}")
    set(TYPE "${type}")
    string(CONFIGURE [=[    {"@ROUTE@", "@TYPE@", {reinterpret_cast<const char*>(kAsset@INDEX@), sizeof(kAsset@INDEX@) - 1}},
]=] row @ONLY)
    string(APPEND table "${row}")
    math(EXPR index "${index}+1")
  endforeach()
  string(APPEND body "const Asset kAssets[] = {\n${table}};\n}  // namespace\n\nstd::span<const Asset> panel_assets() { return kAssets; }\n\n}  // namespace houseguest::service::api\n")
  file(WRITE "${output}.tmp" "${body}")
  execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different "${output}.tmp" "${output}")
endfunction()
